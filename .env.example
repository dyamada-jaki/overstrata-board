# .env にコピーして使う（.env はコミットしない）

# ホスト側のポート。worktree ごとに変えると同時に起動できる
HOST_PORT=5173

# Compose のプロジェクト名。worktree ごとに変えると、コンテナとボリュームが分かれる
# COMPOSE_PROJECT_NAME=overstrata-ci

# ファイル変更が反映されないときは 1 にする
# WATCH_POLLING=1

# ホストで npm run test:e2e を実行するとき、テスト用のアプリ（本番用イメージ）を公開するポート。
# 127.0.0.1 だけに公開する。worktree ごとに変えると同時に実行できる
E2E_HOST_PORT=4173
